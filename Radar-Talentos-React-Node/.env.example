# Servidor HTTP local
HOST=127.0.0.1
PORT=3000

# Caminho do banco SQLite local (ou :memory: em testes)
RADAR_DATABASE_PATH=data/radar.sqlite

# Chave de criptografia AES-GCM em base64 (32 bytes) para segredos em repouso
RADAR_ENCRYPTION_KEY=

# Integrações opcionais (YouTube Data API v3 e Meta Graph API)
YOUTUBE_API_KEY=
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
