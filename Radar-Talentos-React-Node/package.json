{
  "name": "radar-talentos-react-node",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --experimental-sqlite --watch server/src/index.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --experimental-sqlite server/src/index.mjs",
    "test": "node --experimental-sqlite --test tests/*.test.mjs",
    "db:init": "node --experimental-sqlite scripts/init-database.mjs",
    "radar:import": "node --experimental-sqlite scripts/import-radar.mjs",
    "geo:sync": "node --experimental-sqlite scripts/sync-geography.mjs",
    "events:import": "node --experimental-sqlite scripts/import-events.mjs",
    "audience:import": "node --experimental-sqlite scripts/import-audience.mjs",
    "events:coverage": "node --experimental-sqlite scripts/import-coverage.mjs",
    "ops:once": "node --experimental-sqlite scripts/operations.mjs once",
    "ops:worker": "node --experimental-sqlite scripts/operations.mjs worker",
    "ops:check": "node --experimental-sqlite scripts/operations.mjs check",
    "db:backup": "node --experimental-sqlite scripts/backup.mjs",
    "ops:doctor": "node --experimental-sqlite scripts/doctor.mjs",
    "registry:import": "node --experimental-sqlite scripts/import-registry.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "@vitejs/plugin-react": "^5.0.0"
  }
}
